generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE MODELS
// ============================================

model Workspace {
  id          String    @id @default(uuid())
  name        String
  ownerId     String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  
  // Feature flags
  isDeleted   Boolean   @default(false)
  isGeneral   Boolean   @default(false)
  isWorkspace Boolean   @default(false)
  isZone      Boolean   @default(true)
  
  // Relations
  parameters WorkspaceParameter[]
  snapshots  WorkspaceSnapshot[]
  
  @@index([ownerId])
  @@index([deletedAt])
  @@index([isDeleted])
  @@index([createdAt])
  @@map("workspaces")
}

// ============================================
// DYNAMIC PARAMETERS
// ============================================

model WorkspaceParameter {
  id          String   @id @default(uuid())
  workspaceId String
  name        String   // "theme", "settings", "metadata" vb.
  data        Json     // { value: {...}, type: "..." }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([name])
}

// ============================================
// SNAPSHOT for SAGA COMPENSATION
// ============================================

model WorkspaceSnapshot {
  id                  String    @id @default(uuid())
  workspaceId         String
  correlationId       String?
  correlationType     String?
  
  // Snapshot Content
  workspaceSnapshot   Json
  parametersSnapshot  Json
  
  // Metadata
  snapshotReason      String?
  usedForCompensation Boolean   @default(false)
  compensatedAt       DateTime?
  expiresAt           DateTime?
  
  createdAt           DateTime  @default(now())
  
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  @@index([workspaceId])
  @@index([correlationId, correlationType])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([usedForCompensation, createdAt])
}
